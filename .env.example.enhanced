# Enhanced IDS-IPS-Dashboard Environment Configuration
# Based on research paper insights from "Developing a real-time IDPS using Snort with Machine Learning"

# Application Settings
APP_NAME="Enhanced IDS-IPS Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Database Configuration (MySQL/PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ids_ips_dashboard
DB_USERNAME=root
DB_PASSWORD=

# Broadcasting (Real-time Communication)
BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis Configuration (for real-time features)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (Email alerts and notifications)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-security-email@company.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@idsips-company.com"
MAIL_FROM_NAME="${APP_NAME}"

# Alternative Mailtrap Configuration for Development
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your-mailtrap-username
# MAIL_PASSWORD=your-mailtrap-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="noreply@idsips-company.com"
# MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 Configuration (for PCAP file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher (Real-time notifications)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Laravel Sanctum (API Authentication)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# ======================================
# ENHANCED IDS-IPS CONFIGURATION
# ======================================

# Python Configuration
PYTHON_PATH=python3
PYTHON_VERSION=3.9+

# TShark Configuration (from research paper)
TSHARK_PATH=/usr/bin/tshark
TSHARK_ENABLED=true
TSHARK_INTERFACE=eth0
TSHARK_BUFFER_SIZE=32MB
TSHARK_CAPTURE_DURATION=30

# Enhanced ML Pipeline Configuration
ML_ENABLED=true
ML_MODEL_PATH=/storage/app/ml_models
ML_TRAINING_DATASET=CIC-IDS2017
ML_ALGORITHM=random_forest
ML_CONFIDENCE_THRESHOLD=0.7
ML_FEATURE_EXTRACTION=true

# Snort Integration (Dual verification system)
SNORT_ENABLED=true
SNORT_RULES_PATH=/storage/app/snort_rules.txt
SNORT_CONFIG_PATH=/etc/snort/snort.conf
SNORT_INTERFACE=eth0
SNORT_LOG_PATH=/var/log/snort
SNORT_CUSTOM_RULES=true

# Dual Verification System
DUAL_VERIFICATION_ENABLED=true
ML_SNORT_COMBINATION_METHOD=max_confidence
DUAL_VERIFICATION_THRESHOLD=0.5
CROSS_VALIDATION_ENABLED=true

# Flow-based Analysis (Research paper implementation)
FLOW_ANALYSIS_ENABLED=true
FLOW_TIMEOUT=30
FLOW_PACKET_LIMIT=1000
FLOW_FEATURES_EXTRACTION=true
FLOW_STATISTICS_COLLECTION=true

# Real-time Processing Pipeline
REALTIME_PROCESSING_ENABLED=true
PACKET_BATCH_SIZE=10
FLOW_PROCESSING_INTERVAL=5
THREAT_DETECTION_INTERVAL=1
STATISTICS_UPDATE_INTERVAL=10

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=6001
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_WS_SCHEME=ws
WEBSOCKET_WSS_SCHEME=wss

# ======================================
# PERFORMANCE & SCALING
# ======================================

# Packet Processing Optimization
MAX_CONCURRENT_SESSIONS=10
MAX_PACKETS_PER_SECOND=10000
MAX_FLOWS_IN_MEMORY=1000
FLOW_CLEANUP_INTERVAL=60

# Memory Management
PHP_MEMORY_LIMIT=512M
WORKER_MEMORY_LIMIT=1G
GARBAGE_COLLECTION_INTERVAL=300

# Database Optimization
DB_QUERY_CACHE_ENABLED=true
DB_QUERY_CACHE_TTL=3600
DB_CONNECTION_POOL_SIZE=20
DB_IDLE_TIMEOUT=300

# Queue Configuration for Background Processing
QUEUE_WORKERS=4
QUEUE_MAX_JOBS=1000
QUEUE_MAX_TIME=3600
QUEUE_RETRY_AFTER=90

# ======================================
# SECURITY & COMPLIANCE
# ======================================

# Authentication & Authorization
AUTH_TOKEN_EXPIRY=1440
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# API Security
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
API_AUTH_REQUIRED=true
API_CORS_ENABLED=true

# File Upload Security
MAX_PCAP_FILE_SIZE=100MB
ALLOWED_PCAP_EXTENSIONS=pcap,cap,pcapng
PCAP_SCAN_ENABLED=true
PCAP_VIRUS_SCAN=false

# Network Security
FIREWALL_INTEGRATION_ENABLED=false
IP_BLOCKING_ENABLED=false
IP_BLACKLIST_ENABLED=false
AUTO_RESPONSE_ENABLED=false

# ======================================
# MONITORING & LOGGING
# ======================================

# Logging Configuration
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_MAX_FILES=30
LOG_MAX_SIZE=100MB

# Enhanced Logging
ML_LOGGING_ENABLED=true
SNORT_LOGGING_ENABLED=true
FLOW_LOGGING_ENABLED=true
PERFORMANCE_LOGGING_ENABLED=true
SECURITY_LOGGING_ENABLED=true

# ELK Stack Integration (Research paper recommendation)
ELK_ENABLED=false
ELK_HOST=localhost
ELK_PORT=9200
ELK_INDEX_PREFIX=ids-ips-
ELK_LOG_RETENTION_DAYS=30

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_METRICS_ENDPOINT=/metrics
PERFORMANCE_HEALTHCHECK_ENDPOINT=/health

# ======================================
# RESEARCH PAPER SPECIFIC SETTINGS
# ======================================

# TShark Integration (Paper requirement)
TSHARK_CAPTURE_MODE=real-time
TSHARK_FEATURE_EXTRACTION=true
TSHARK_FLOW_ANALYSIS=true

# CIC-IDS2017 Dataset Configuration
DATASET_PATH=/storage/app/datasets
DATASET_PREPROCESSING_ENABLED=true
DATASET_FEATURE_REDUCTION=PCA
DATASET_TRAIN_TEST_SPLIT=80-20

# Random Forest Model Configuration
RANDOM_FOREST_N_ESTIMATORS=100
RANDOM_FOREST_RANDOM_STATE=42
RANDOM_FOREST_MAX_DEPTH=20
RANDOM_FOREST_MIN_SAMPLES_SPLIT=2

# Performance Benchmarks (from research paper)
TARGET_ACCURACY=98.0
MAX_FALSE_POSITIVE_RATE=2.0
MIN_DETECTION_SPEED=0.05
MAX_PROCESSING_LATENCY=0.1

# Automated Response System (Future enhancement)
AUTO_RESPONSE_ENABLED=false
AUTO_RESPONSE_FIREWALL_BLOCK=true
AUTO_RESPONSE_IP_BLACKLIST=true
AUTO_RESPONSE_EMAIL_ALERT=true
AUTO_RESPONSE_CONFIDENCE_THRESHOLD=0.8

# ======================================
# DEVELOPMENT & DEBUGGING
# ======================================

# Debug Configuration
DEBUG_SQL_QUERIES=false
DEBUG_API_REQUESTS=false
DEBUG_PIPELINE_PROCESSING=false
DEBUG_ML_PREDICTIONS=false

# Testing Configuration
TEST_DATABASE_URL=mysql://root:@127.0.0.1/ids_ips_dashboard_test
TEST_PACKET_SAMPLE_PATH=/storage/app/test/samples
TEST_MODEL_PATH=/storage/app/test/models

# Development Tools
DUSK_DRIVER_CHROME=false
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# ======================================
# DEPLOYMENT CONFIGURATION
# ======================================

# Docker Configuration
DOCKER_ENABLED=false
DOCKER_IMAGE_NAME=ids-ips-dashboard
DOCKER_CONTAINER_NAME=ids-ips-app

# Nginx Configuration
NGINX_ENABLED=false
NGINX_SSL_ENABLED=false
NGINX_REVERSE_PROXY=true

# SSL/TLS Configuration
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_FORCE_HTTPS=true

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_PATH=/backups

# ======================================
# ADVANCED FEATURES
# ======================================

# Machine Learning Enhancement
ML_PIPELINE_PARALLEL_PROCESSING=true
ML_MODEL_VERSIONING_ENABLED=true
ML_AUTOMATIC_RETRAINING=false
ML_HYPERPARAMETER_TUNING=false

# Threat Intelligence Integration
THREAT_INTEL_ENABLED=false
THREAT_INTEL_API_KEY=
THREAT_INTEL_UPDATE_INTERVAL=24
THREAT_FEED_URLS=""

# Cloud Integration
CLOUD_MONITORING_ENABLED=false
CLOUD_STORAGE_ENABLED=false
CLOUD_BACKUP_ENABLED=false

# Compliance & Reporting
COMPLIANCE_REPORTING_ENABLED=false
COMPLIANCE_FRAMEWORK="ISO27001"
REPORT_GENERATION_SCHEDULE="0 9 * * 1"
AUDIT_LOGGING_ENABLED=true