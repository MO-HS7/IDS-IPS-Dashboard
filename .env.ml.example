# Machine Learning Configuration
ML_PYTHON_PATH=python
ML_MODELS_DIR=ml_models
ML_SCRIPTS_DIR=ml_scripts
ML_PREDICTION_TIMEOUT=30
ML_BATCH_SIZE=100

# Alert Generation
ML_ALERT_THRESHOLD=70
ML_SEVERITY_CRITICAL=95
ML_SEVERITY_HIGH=85
ML_SEVERITY_MEDIUM=70
ML_SEVERITY_LOW=50

# Auto-Response Configuration
ML_AUTO_RESPONSE_ENABLED=false
ML_AUTO_RESPONSE_MIN_SEVERITY=85
ML_AUTO_RESPONSE_BLOCK_IP=false
ML_AUTO_RESPONSE_ISOLATE=false
ML_AUTO_RESPONSE_NOTIFY=true

# Notifications
ML_EMAIL_ON_CRITICAL=true
ML_EMAIL_ON_HIGH=true
ML_EMAIL_ON_MEDIUM=false
ML_EMAIL_RECIPIENTS=admin@example.com,security@example.com

# Model Version
ML_MODEL_VERSION=1.0.0
ML_ACTIVE_MODEL=random_forest_model.pkl
